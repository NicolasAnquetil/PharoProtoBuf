"
Hand-written fixture for tutorial.AddressBook from samples/addressbook.proto:
message AddressBook { repeated Person people = 1; }
Class side #sampleBytes holds samples/addressbook-sample.bin, written by the official protobuf Java example.
"
Class {
	#name : 'PBExAddressBook',
	#superclass : 'PBMessage',
	#instVars : [
		'people'
	],
	#category : 'Protobuf-Core-Tests-Fixtures',
	#package : 'Protobuf-Core-Tests',
	#tag : 'Fixtures'
}

{ #category : 'descriptor' }
PBExAddressBook class >> descriptor [

	^ PBMessageDescriptor new
		  repeated: #people number: 1 message: PBExPerson;
		  yourself
]

